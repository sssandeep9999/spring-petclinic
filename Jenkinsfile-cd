pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag passed from CI')
        choice(name: 'ENVIRONMENT', choices: ['dev', 'qa', 'uat', 'prod'], description: 'Target environment')
    }

    environment {
        IMAGE_NAME     = "petclinic-app"
        DEPLOYMENT     = "petclinic-deployment"
        DOCKERHUB_USER = "satyasandeep901"
        
        // Dynamic target selection based on parameters passed
        KUBE_NAMESPACE = "${params.ENVIRONMENT}"
        TARGET_TAG     = "${params.IMAGE_TAG}"
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Trivy Security Scan') {
            steps {
                echo "Scanning image: ${DOCKERHUB_USER}/${IMAGE_NAME}:${TARGET_TAG}"
                sh """
                trivy image \
                --severity HIGH,CRITICAL \
                --exit-code 1 \
                --no-progress \
                ${DOCKERHUB_USER}/${IMAGE_NAME}:${TARGET_TAG}
                """
            }
        }

        stage('Production Manual Approval Gate') {
            when {
                expression { params.ENVIRONMENT == 'prod' }
            }
            steps {
                script {
                    timeout(time: 1, unit: 'DAYS') {
                        input message: "Approve deployment of version ${TARGET_TAG} to PRODUCTION?",
                              ok: "Release to Prod"
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo "Deploying version ${TARGET_TAG} to namespace: ${KUBE_NAMESPACE}"
                sh """
                kubectl set image deployment/${DEPLOYMENT} \
                petclinic-container=${DOCKERHUB_USER}/${IMAGE_NAME}:${TARGET_TAG} -n ${KUBE_NAMESPACE}
                """
            }
        }

        stage('Verify Rollout') {
            steps {
                sh "kubectl rollout status deployment/${DEPLOYMENT} -n ${KUBE_NAMESPACE}"
            }
        }

        stage('App Health Check') {
            steps {
                // Dynamically direct your check based on the environment rules or routing setup
                echo "Running health checks for ${KUBE_NAMESPACE}..."
                sh 'curl -s http://172.18.0.3:31028/actuator/health | grep UP || exit 1'
            }
        }
    }

    post {
        success {
            mail to: 'satyasaisandeep9@gmail.com',
                 subject: "SUCCESS: Environment [${params.ENVIRONMENT.toUpperCase()}] Deployment - Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]'",
                 body: "Deployment of version ${params.IMAGE_TAG} to ${params.ENVIRONMENT} was successful."
        }
        failure {
            echo "Deployment failed. Rolling back..."
            sh "kubectl rollout undo deployment/${DEPLOYMENT} -n ${KUBE_NAMESPACE}"
            mail to: 'satyasaisandeep9@gmail.com',
                 subject: "FAILED: Environment [${params.ENVIRONMENT.toUpperCase()}] Deployment - Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]'",
                 body: "Deployment of version ${params.IMAGE_TAG} failed. Automated rollback executed."
        }
    }
}
